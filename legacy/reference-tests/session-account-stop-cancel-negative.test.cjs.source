// Negative control: cancellation occurs after previous logout and view teardown.
// This executes the actual combined changeAccount function in a synthetic shell.
const vm=require('node:vm'),fs=require('node:fs'),path=require('node:path'),assert=require('node:assert/strict');
const source=fs.readFileSync(path.resolve(__dirname,'../active-system/app.js'),'utf8');
const fn=source.slice(source.indexOf('async function changeAccount('),source.indexOf('async function maintainIdentity('));
assert.ok(fn.startsWith('async function changeAccount('));
const context=vm.createContext({console,setTimeout,clearTimeout});
vm.runInContext(`let accountTransition=false,sessionEnding=false,bootEpoch=0,guestFiles={ready:true},terminalMuxReady=true,terminalSessions=new Map(),currentSession={public:{sub:'old'}},nextSession={public:{sub:'new'}},wanted=true,stopped,loggedOut=[];const identityConfig={};const identityModule={logoutSession:async(_config,session)=>{loggedOut.push(session.public.sub)}};const surfaces=new Map();const guestNetworkAdapter=null;let v86Instance={stop:()=>new Promise(r=>stopped=r)};const tracker={changed:()=>false,quiesce:async()=>{},dispose(){}};const confirmSessionEnd=async()=>({initial:[],tracker}),trackSessionEdits=()=>tracker,sessionDirtyWindows=()=>[],sameDirtyWindows=()=>true,accountSession=async()=>nextSession,sessionViews=x=>x,startMirror=()=>{},closeBrowserSourcePages=()=>{},startGuest=async()=>{},feedback=()=>{};${fn};globalThis.begin=()=>changeAccount('signin','','',()=>wanted);globalThis.stopWaiting=()=>typeof stopped==='function';globalThis.cancel=()=>{wanted=false};globalThis.release=()=>stopped();globalThis.result=()=>({subject:currentSession.public.sub,loggedOut});`,context);
(async()=>{const operation=context.begin();while(!context.stopWaiting())await new Promise(r=>setTimeout(r,1));context.cancel();context.release();await operation;const result=context.result();assert.equal(result.subject,'new');assert.deepEqual(Array.from(result.loggedOut),['old']);console.log('NEGATIVE: caller cancellation during guest stop still commits next account, after previous logout')})().catch(error=>{console.error(error);process.exitCode=1});
